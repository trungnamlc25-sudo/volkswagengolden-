# ==========================================================
# CẤU HÌNH SUPABASE CLOUD DATABASE (TÙY CHỌN)
# 1. Đăng ký tài khoản miễn phí tại: https://supabase.com
# 2. Tạo một Project mới (chọn Region Singapore để nhanh nhất)
# 3. Vào Project Settings -> API -> Copy URL và anon public key dán vào đây:
# ==========================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
